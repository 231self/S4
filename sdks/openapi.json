"aws_role","managed"]},"CreateKeyRequest":{"type":"object","required":["label"],"properties":{"expires_in":{"type":"integer","format":"int64","minimum":0},"label":{"type":"string"},"public_key_pem":{"type":["string","null"]}}},"DeleteKeyRequest":{"type":"object","required":["key_id"],"properties":{"key_id":{"type":"string"}}},"ListKeyResponse":{"type":"object","required":["key_id","label","created_at"],"properties":{"created_at":{"type":"string"},"expires_at":{"type":["string","null"]},"key_id":{"type":"string"},"label":{"type":"string"},"public_key_pem":{"type":["string","null"]}}},"ObjectResponse":{"type":"object","required":["key","size"],"properties":{"key":{"type":"string"},"size":{"type":"integer","minimum":0}}}}},"tags":[{"name":"keys","description":"API key management"},{"name":"objects","description":"Object store listing"}]}